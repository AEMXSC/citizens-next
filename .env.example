# ---------------------------------------------------------------------------
# AEM headless + Universal Editor starter — single source of configuration.
# Copy this file to .env.local and configure the values you need. Nothing else in the
# codebase reads process.env directly; src/lib/aem-config.ts is the one reader.
# ---------------------------------------------------------------------------

# AEM author instance (used for the Universal Editor connection and for
# author-side, credentialed reads when editing). No trailing slash.
AEM_AUTHOR=https://author-<prog>-<env>.adobeaemcloud.com

# AEM publish instance (used for public, server-side reads). No trailing slash.
AEM_PUBLISH=https://publish-<prog>-<env>.adobeaemcloud.com

# Persisted-query namespace, i.e. the first path segment after
# /graphql/execute.json/. For the XSC Showcase content this is the project the
# queries were created under (for example: securbank). Do NOT include a slash.
AEM_CF_PREFIX=<project>

# Optional. Technical-account / service token for tenants whose persisted
# queries are NOT published public. Leave blank when queries are public.
AEM_TOKEN=

# Set to true only when serving this app INSIDE Universal Editor. When true the
# app injects the UE connection.
UE_ENABLED=false

# Opt in to Frescopa EDS structured-content list reads for cards and insights
# after the worker list API is deployed and the indexed documents are available.
# Offers and disclosures stay on AEM.
EDS_CONTENT_ENABLED=false

# Optional local structured-content worker origin for testing before deployment.
# Leave blank to use https://da-sc.adobeaem.workers.dev.
EDS_WORKER_BASE=

# Optional. Adobe Fonts (Typekit) kit id for the customer brand font. Public by
# design (it ships in the <head>), hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_FONT_KIT=

# Optional. Brand name shown in the masthead. Public build value.
NEXT_PUBLIC_BRAND_NAME=
